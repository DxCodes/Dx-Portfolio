# Contact form (https://resend.com). Without RESEND_API_KEY the form shows a mailto fallback.
RESEND_API_KEY=
# Where messages are delivered. Defaults to the email in data/site.ts.
CONTACT_TO=
# Verified sender on your Resend domain. Defaults to Resend's test sender.
CONTACT_FROM="Portfolio <hello@heyitsdhruv.com>"
