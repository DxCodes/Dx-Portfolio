# Contact form (https://resend.com). Without RESEND_API_KEY the form shows a mailto fallback.
RESEND_API_KEY=
# Inbox that receives messages. Defaults to the email in data/site.ts.
CONTACT_TO=
# Sender on your verified Resend domain. Defaults to Resend's test sender (onboarding@resend.dev),
# which can only deliver to the email you signed up to Resend with.
CONTACT_FROM="Portfolio <hello@heyitsdhruv.com>"

# Rate limit: one message per visitor every 5 minutes. Optional — without these the limit is
# kept in memory, which doesn't hold reliably on Vercel. Get them from Upstash Redis
# (Vercel → Storage → Upstash adds them automatically as KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
